# Cxr Multimodal Report Grounder - Environment Configuration
# Copy this file to .env and set your own secure values

# HMAC-SHA256 Audit Trail Secret Key (minimum 16 characters)
# Generate a secure key: python -c "import secrets; print(secrets.token_hex(32))"
AUDIT_SECRET_KEY=change-me-to-a-secure-random-key-min-16-chars

# LLM Provider: mock, ollama, claude, openai
MODEL_PROVIDER=mock
